{
  "name": "@guoxk/gplayer",
  "version": "0.1.0",
  "type": "module",
  "description": "A Vue 3 video player component supporting MPD/DASH, M3U8/HLS, FLV and MP4 formats",
  "author": "guoxk",
  "license": "MIT",
  "homepage": "https://github.com/guoxk/gplayer#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/guoxk/gplayer.git",
    "directory": "packages/gplayer"
  },
  "keywords": [
    "vue",
    "vue3",
    "video",
    "player",
    "hls",
    "dash",
    "flv",
    "m3u8",
    "mpd"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./style.css": "./dist/style.css"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "vue": ">=3.3.0",
    "@vueuse/core": ">=10.0.0",
    "hls.js": ">=1.0.0",
    "dashjs": ">=4.0.0",
    "flv.js": ">=1.6.0"
  },
  "peerDependenciesMeta": {
    "hls.js": {
      "optional": true
    },
    "dashjs": {
      "optional": true
    },
    "flv.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vueuse/core": "catalog:",
    "dashjs": "catalog:",
    "flv.js": "catalog:",
    "hls.js": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unplugin-vue": "^5.2.1",
    "vue": "catalog:",
    "vue-tsc": "^2.2.10"
  }
}
